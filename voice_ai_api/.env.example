# ============================================
# Voice AI API - Environment Variables
# ============================================

# D-ID Configuration
# Get your API key from: https://www.d-id.com/
D_ID_API_KEY=your_d_id_api_key_here

# ElevenLabs Configuration (for D-ID voice)
# Get your API key from: https://elevenlabs.io/
ELEVEN_LABS_API_KEY=your_eleven_labs_api_key_here

# AssemblyAI Configuration
# Get your API key from: https://www.assemblyai.com/
ASSEMBLY_AI_API_KEY=your_assembly_ai_api_key_here

# Rails Configuration
RAILS_ENV=development
RAILS_MAX_THREADS=5

# Database Configuration (optional, defaults to SQLite)
# DATABASE_URL=postgresql://username:password@localhost/voice_ai_api_development

# Redis Configuration (for production with Sidekiq)
# REDIS_URL=redis://localhost:6379/1

# Secret Key Base (generate with: rails secret)
# SECRET_KEY_BASE=your_secret_key_base_here

# CORS Origins (production)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# API Rate Limiting
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_PERIOD=60

# Logging
# LOG_LEVEL=info
