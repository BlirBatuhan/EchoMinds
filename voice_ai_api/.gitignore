# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key

# ============================================
# Ruby on Rails - Extended Ignore Rules
# ============================================

# SQLite3 databases
*.sqlite3
*.sqlite3-*
/db/*.sqlite3
/db/*.sqlite3-*
/db/*.sqlite3-journal

# Rails cache and temp files
/tmp/cache/
/tmp/pids/
/tmp/sockets/
/public/system/
/public/uploads/
/public/assets/
/public/packs/
/public/packs-test/

# Rails logs
/log/*.log
*.log

# Rails credentials
/config/credentials.yml.enc
/config/credentials/*.key

# Environment files
.env
.env.*
!.env.example
.envrc

# Ruby version managers
.ruby-version
.ruby-gemset
.rvmrc
.rbenv-version

# Bundler
/vendor/bundle/
/.bundle
Gemfile.lock

# RubyMine & JetBrains IDEs
/.idea
*.iml
*.ipr
*.iws
.rakeTasks

# VS Code
.vscode/
*.code-workspace

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# Node modules (if using webpacker/jsbundling)
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Test coverage
/coverage/
/spec/tmp/
/spec/reports/
/.rspec_status

# SimpleCov
/coverage.data
/.resultset.json

# Ignore byebug command history
.byebug_history

# Ignore spring files
/spring/*.pid

# Docker
.dockerignore
docker-compose.override.yml

# Kamal secrets
/.kamal/secrets
/.kamal/secrets-*

# Solid Queue
/tmp/solid_queue_*

# Ignore Action Cable configs
/config/cable.yml

# Ignore public uploads
/public/uploads/*
/public/system/*

# Ignore development database backups
/db/backups/
*.dump
*.sql

# Ruby debug
.rdbgrc.breakpoints
.rdbgrc

# Terraform (if using for deployment)
*.tfstate
*.tfstate.*
.terraform/

# Ignore all compiled assets
/public/assets/
/public/packs/

# Ignore zeitwerk
/tmp/zeitwerk/

# Ignore bootsnap cache
/tmp/cache/bootsnap*/

# Ignore development/test data
/db/test_data/
/db/seeds_backup/

# Postman collections (keep template, ignore local versions)
*_LOCAL.postman_collection.json

# API Keys and Secrets (IMPORTANT!)
/config/secrets.yml
api_keys.txt
credentials.txt

# Ignore show_db.rb and other temp scripts
show_db.rb
test_*.rb
scratch_*.rb
