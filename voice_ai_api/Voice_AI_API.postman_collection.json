							"path": ["transcript_comparisons", "1"]
						},
						"description": "Belirli bir transkript karşılaştırmasını getirir.\n\n**İçerik:**\n- reference_text: Orijinal metin\n- transcript_text: AssemblyAI çıktısı\n- similarity_score: 0-100 arası benzerlik\n- mismatched_words: Eksik ve fazla kelimeler"
					},
					"response": []
				}
			]
		},
